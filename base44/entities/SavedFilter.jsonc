{
  "name": "SavedFilter",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "",
        "LOW",
        "MEDIUM",
        "HIGH",
        "URGENT"
      ],
      "default": ""
    },
    "assignee": {
      "type": "string",
      "default": ""
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "search": {
      "type": "string",
      "default": ""
    },
    "workspace": {
      "type": "string"
    },
    "workspace_name": {
      "type": "string"
    },
    "workspace_members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "name",
    "workspace",
    "workspace_members"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace_members": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.workspace_members": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workspace_members": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace_members": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}